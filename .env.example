# ============================================================
# Easton Land Works pipeline — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Email sending (Phase 2) ---
# Pick ONE provider. Postmark recommended for transactional / records requests.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=records@eastonlandworks.com
POSTMARK_FROM_NAME="Easton Land Works"
POSTMARK_REPLY_TO=records@eastonlandworks.com

# Daily send cap (start low while domain warms up — bump after 2 weeks)
EMAIL_DAILY_CAP=50

# --- Zamplo (Phase 4) ---
# Confirm exact env var names with Zamplo support when you get the key
ZAMPLO_API_KEY=
ZAMPLO_API_BASE_URL=https://data.zamplo.com/api/v1

# --- Database ---
# Absolute path recommended. Default is relative to repo root.
DATABASE_PATH=data/pipeline.db

# --- OCR (Phase 3, scanned PDFs only) ---
# Only fill these if you opt into Textract over local Tesseract
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Operational ---
LOG_LEVEL=INFO
ENVIRONMENT=dev   # dev | prod
